{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/app/lib/**/*.ts",
    "src/app/data/**/*.ts",
    "src/app/types/**/*.ts",
    "src/types/**/*.ts",
    "src/app/contexts/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": [
    "src/app/data/world-map.ts"
  ]
}
