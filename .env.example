# Public client configuration only. Obtain local values with `./pnpmw exec supabase status`.
# Never add a service-role or secret key, database password, OAuth secret, or SMTP secret here.
#
# When both values are set to real values, the web app signs in and stores data through Supabase.
# Leave them unset (or keep the placeholder) to run the browser-only design prototype.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
