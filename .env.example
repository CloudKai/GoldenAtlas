# Public client configuration only. Obtain local values with `pnpm exec supabase status`.
# Never add a service-role key, database password, OAuth secret, or SMTP secret here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Reserved for the future Expo client milestone.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
EXPO_PUBLIC_APP_SCHEME=goldenatlas
